def main(argv):
    args, out, repo = list(argv[1:]), None, None
    while args:
        a = args.pop(0)
        if a in ("-h", "--help"):
            print(__doc__)
            return 0
        if a == "-o":
            if not args or not args[0]:
                print(f"rada-tribute: -o needs a file name\n{USAGE}", file=sys.stderr)
                return 2
            out = args.pop(0)
        elif a.startswith("-") or repo is not None:
            print(USAGE, file=sys.stderr)
            return 2
        else:
            repo = a
    if rada_avatar is None:
        print("rada-tribute: tools/rada_avatar.py, which draws the agents' avatars, is missing next to this tool",
              file=sys.stderr)
        return 2
    repo = repo or "."
    top = subprocess.run(["git", "-C", repo, "rev-parse", "--show-toplevel"], capture_output=True, text=True).stdout.strip() or repo
    path = os.path.join(top, "REGISTER.md")
    try:
        text = open(path, encoding="utf-8").read()
    except OSError:
        print(f"rada-tribute: no REGISTER.md in {top}", file=sys.stderr)
        return 2
    words, code = dedication()
    if words is None:
        return code
    header, entries = parse(text)
    if not entries:
        print("rada-tribute: REGISTER.md has no entries (a \"## \" heading with fields under it)", file=sys.stderr)
        return 2
    page = build(header, entries, words)
    if out is None:
        sys.stdout.buffer.write(page.encode("utf-8"))
        return 0
    try:
        with open(out, "w", encoding="utf-8") as f:
            f.write(page)
    except OSError as e:
        print(f"rada-tribute: cannot write {out}: {e.strerror or e}", file=sys.stderr)
        return 2
    print(f"rada-tribute: wrote {out} ({len(entries)} entries)")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
