def parse(text):
    """The header and the entries, read as rada-lint and the hook read them: a field anywhere in its block,
    the first line of a key wins, an empty value or a "<placeholder>" is absent."""
    header, entries, cur, keys, seen = {}, [], None, HEADER_KEYS, set()
    # lines split on LF only and a comment keeps its line breaks, as rada-lint reads the file
    for line in COMMENT.sub(lambda c: "\n" * c.group().count("\n"), text).split("\n"):
        line = line.rstrip("\r")
        if line.startswith("## "):
            name = line[3:].strip()
            cur, keys, seen = {"name": name}, ENTRY_KEYS, set()
            if not EXAMPLE.fullmatch(name):
                entries.append(cur)  # the example's block is read into cur and dropped
            continue
        m = FIELD.match(line)
        if not m or m.group(1) not in keys:
            continue
        key, value = m.group(1), m.group(2).strip()
        if key == "kind":
            value = value.lower().split()[0] if value else ""  # its first word, as rada-lint reads it
        if key in seen:
            continue  # the first line of a key wins, even when it holds a placeholder
        seen.add(key)
        if value and not value.startswith("<"):
            (header if cur is None else cur)[key] = value
    # a heading with no fields under it is prose; an entry without a session is still shown (rada-lint asks for one)
    return header, [e for e in entries if ENTRY_KEYS & e.keys()]


def paras(value):
    return [p.strip() for p in (value or "").split(" | ") if p.strip()]


def esc(s):
    return html.escape(s, quote=True)


