              "haiku", "stat", "hashes", "kind", "count"}
FIELD = re.compile(r"^- ([a-z_]+):(.*)$")
EXAMPLE = re.compile(r"<.*>")  # "## <...>": the template's example heading, not an entry
COMMENT = re.compile(r"<!--.*?-->", re.S)  # an unclosed "<!--" is text, as Markdown shows it
