           "resume": "Resume", "again": "Watch again", "watch": "▶ Watch",
           "note": "The music opens in a new tab. “Sound” plays the page's own drone, metal, chords and the clatter of the carriage.",
           "note_nomusic": "“Sound” plays the page's own drone, metal, chords and the clatter of the carriage.",
           "sessions": "Sessions", "scouts": "Scouts", "commits": "Commits", "mode": "Mode: tribute",
           "analysis": "Analysis: Rada agents", "kicker": "Rada · anchor · tribute", "sub": "In honour of the agents who served under “Rada · anchor”"},
