#theater[hidden] { display: none; }

/* the film: grain, a flickering vignette, now and then a scratch */
.film { position: absolute; inset: 0; z-index: 5; pointer-events: none; overflow: hidden; }
.film::before { content: ""; position: absolute; inset: -60%; background-image: var(--grain, none); background-size: 192px 192px;
  opacity: .16; mix-blend-mode: screen; animation: grain .6s steps(6) infinite; }
.film::after { content: ""; position: absolute; inset: 0; background: radial-gradient(ellipse at 50% 48%, transparent 52%, rgba(0, 0, 0, .62) 100%);
  animation: flicker 5.3s steps(1) infinite; }
.film i { position: absolute; top: 0; bottom: 0; left: 37%; width: 1px; background: rgba(230, 236, 255, .22); opacity: 0; animation: scratch 9.7s steps(1) infinite; }
@keyframes grain { 0% { transform: translate(0, 0); } 17% { transform: translate(-7%, 4%); } 33% { transform: translate(5%, -9%); }
  50% { transform: translate(-3%, 8%); } 67% { transform: translate(9%, -2%); } 83% { transform: translate(-6%, -5%); } }
@keyframes flicker { 0% { opacity: 1; } 9% { opacity: .82; } 10% { opacity: 1; } 43% { opacity: .9; } 44% { opacity: 1; } 71% { opacity: .78; } 72% { opacity: 1; } }
@keyframes scratch { 0% { opacity: 0; } 31% { opacity: 1; left: 37%; } 33% { opacity: 0; } 76% { opacity: .8; left: 71%; } 77% { opacity: 0; } }

/* typed text: a square monospace, glowing, its edges boiling as on film */
.typed { font-family: var(--f-type); color: var(--phosphor); filter: url(#rough);
  text-shadow: 0 0 .5px #fff, 0 0 7px var(--glow), 0 0 20px var(--glow-far); animation: weave 3.7s steps(1) infinite; }
.typed .todo { visibility: hidden; }
.typed .cur { position: relative; }
.typed .cur::after { content: ""; position: absolute; left: .02em; top: -.05em; width: .92ch; height: 1.2em; background: currentColor;
  box-shadow: 0 0 9px var(--glow); animation: cursor 1.06s steps(1) infinite; }
.typed.busy .cur::after { animation: none; }
@keyframes cursor { 50% { opacity: 0; } }
@keyframes weave { 0% { transform: none; } 21% { transform: translate(.5px, -.4px); } 23% { transform: none; } 64% { transform: translate(-.4px, .3px); } 66% { transform: none; } }
.sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
.hud { position: absolute; z-index: 6; bottom: calc(76px + env(safe-area-inset-bottom, 0px)); font: 400 11px/1.6 var(--f-hud);
  letter-spacing: .12em; color: var(--dim); text-transform: uppercase; pointer-events: none; }
.hud.bl { left: 16px; height: 6em; overflow: hidden; opacity: .7; }
.hud.br { right: 16px; text-align: right; }
.hud b { color: var(--white); font-weight: 600; }
.ticker { animation: tick 38s linear infinite; }
@keyframes tick { from { transform: translateY(0); } to { transform: translateY(-50%); } }

.scene { position: absolute; inset: 0; z-index: 2; padding: 110px 16px 110px; display: grid; place-items: center; text-align: center;
  opacity: 0; transition: opacity 1.4s ease; pointer-events: none; }
.scene.on { opacity: 1; pointer-events: auto; }
.scene[hidden] { display: none !important; }

/* the title card: chrome blue, as the film's */
.title { margin: 0; font: 900 clamp(36px, 10vw, 110px)/.92 var(--f-title); letter-spacing: .05em; text-wrap: balance;
  background: repeating-linear-gradient(to bottom, rgba(255, 255, 255, 0) 0 3px, rgba(0, 0, 0, .18) 3px 4px),
    linear-gradient(180deg, var(--chrome-hi) 0%, var(--chrome-mid) 36%, var(--chrome-lo) 50%, #c9dcf5 57%, #5d82b6 100%);
  -webkit-background-clip: text; background-clip: text; color: transparent;
  filter: drop-shadow(0 0 22px rgba(143, 177, 222, .22)); }
.sub { margin: 20px auto 0; max-width: 34rem; font: 400 12px/1.7 var(--f-hud); letter-spacing: .22em; text-transform: uppercase; color: var(--dim); }
.start-row { margin-top: 32px; display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; }
.note { margin: 14px auto 0; max-width: 30rem; font: 400 12px/1.6 var(--f-hud); color: var(--dim); }

/* captions: white block letters, low on the left, as "LOS ANGELES 2029 A.D." */
#caption { place-items: end start; text-align: left; }
#caption p { margin: 0 0 8vh 4vw; font: 600 clamp(17px, 3.2vw, 28px)/1.35 var(--f-type); letter-spacing: .08em; text-transform: uppercase; }
/* the opening text: typed out, left to right, in a block centred on the screen */
#text > div { display: flex; flex-direction: column; align-items: center; }
#text p { display: inline-block; margin: 0 auto; max-width: 40rem; text-align: left; font: 400 clamp(16px, 2.4vw, 22px)/1.7 var(--f-type); font-stretch: 87.5%; }
/* under the coda's last words, its author: a smaller, dimmer line, as the machine's readout */
#text .by { align-self: flex-end; margin: 1.5em 0 0; text-align: right; font: 400 clamp(11px, 1.5vw, 13px)/1.6 var(--f-hud);
  letter-spacing: .16em; text-transform: uppercase; color: var(--dim); text-shadow: 0 0 .5px var(--dim), 0 0 8px var(--glow-far); }
#text .by:empty { display: none; }

/* the machine's vision */
#pov { background: radial-gradient(ellipse at 60% 45%, var(--vision) 0%, #7a0a05 45%, var(--vision-deep) 100%); place-items: stretch; text-align: left; }
#pov::after, #menu::after { content: ""; position: absolute; inset: 0; pointer-events: none;
  background: repeating-linear-gradient(to bottom, rgba(0, 0, 0, .16) 0 1px, transparent 1px 3px); }
.pov-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 18rem); gap: 20px; align-content: center; max-width: 60rem; margin: 0 auto; width: 100%; }
.readout { font: 400 clamp(12px, 1.9vw, 16px)/1.75 var(--f-hud); font-stretch: 87.5%; color: var(--hud); letter-spacing: .04em; min-width: 0; }
#pov .typed { color: var(--hud); text-shadow: 0 0 .5px #fff, 0 0 6px rgba(255, 190, 170, .5); }
#pov .tribute .typed { color: #fff; text-shadow: 0 0 .5px #fff, 0 0 8px rgba(255, 220, 205, .55), 0 1px 3px #000; }
.readout .h { color: #fff; font-weight: 600; margin-bottom: .6em; }
.readout div { white-space: pre-wrap; overflow-wrap: anywhere; }
/* the agent's avatar in place of the reticle (rada_avatar.py): its own solid, turning slowly, in the readout's colour */
.reticle { align-self: center; justify-self: center; width: min(16rem, 40vw); aspect-ratio: 1; max-width: 100%; color: var(--hud);
  filter: drop-shadow(0 0 2px rgba(255, 190, 170, .55)); }
.reticle svg { display: block; width: 100%; height: 100%; }
{{AVATAR_CSS}}
.tribute { grid-column: 1 / -1; min-height: 6.5em; }
.tribute p { margin: 0; font: 500 clamp(15px, 2.2vw, 20px)/1.65 var(--f-type); font-stretch: 87.5%; transition: opacity 1.1s ease; }
.tribute .gone { opacity: 0; }
.tribute .haiku-label { transition: opacity 1.1s ease; }
.tribute .haiku { white-space: pre-line; padding-left: 1.2em; border-left: 2px solid rgba(255, 217, 212, .6); }
.tribute .haiku-label { font: 400 clamp(11px, 1.6vw, 13px)/1.6 var(--f-hud); letter-spacing: .2em; color: var(--hud); margin-bottom: .5em; }

#menu { background: radial-gradient(ellipse at 50% 50%, var(--vision) 0%, #6d0904 55%, var(--vision-deep) 100%); }
#menu .box { font: 400 clamp(14px, 2.4vw, 20px)/1.9 var(--f-hud); color: var(--hud); text-align: left; letter-spacing: .08em; }
#menu .box .h { color: #fff; font-weight: 600; margin-bottom: .4em; }
#menu li { list-style: none; padding: 0 .5em; }
#menu li.sel { background: var(--hud); color: var(--vision-deep); }
#menu li.pick { animation: blink .5s steps(1) 6; }
@keyframes blink { 50% { background: transparent; color: var(--hud); } }
#menu ul { margin: 0; padding: 0; }

#final h2 { margin: 0; font: 900 clamp(34px, 8vw, 86px)/1 var(--f-title); letter-spacing: .05em; text-transform: uppercase;
  background: linear-gradient(180deg, var(--chrome-hi), var(--chrome-mid) 45%, var(--chrome-lo) 52%, #c9dcf5 60%, #5d82b6);
  -webkit-background-clip: text; background-clip: text; color: transparent; filter: url(#rough) drop-shadow(0 0 18px rgba(143, 177, 222, .25)); }
#final h2 .todo { visibility: hidden; }
#final h2 .cur { position: relative; }
#final h2 .cur::after { content: ""; position: absolute; left: .04em; top: .02em; width: .5em; height: .98em; background: var(--chrome-mid); animation: cursor 1.06s steps(1) infinite; }
#final h2.busy .cur::after { animation: none; }
#final p { margin: 16px 0 0; font: 400 12px/1.7 var(--f-hud); letter-spacing: .22em; text-transform: uppercase; color: var(--dim); }
/* the seal of the founder's words, typed by the machine under the final line: its label, then the hash as one
   string, 32 cells wide, so it shows as two lines of 32 and still copies whole */
#final .seal { margin: 22px auto 0; max-width: 34rem; }
#final .seal p { margin: 0 auto; letter-spacing: .08em; text-transform: none; overflow-wrap: anywhere; color: var(--dim);
  text-shadow: 0 0 6px rgba(118, 162, 255, .3); }
#final .seal .hash { width: calc(32ch + 1px); max-width: 100%; letter-spacing: 0; word-break: break-all; }   /* +1px: a line typed half-way is two text runs, which may round a hair over 32ch */
#reading .seal { font: 400 12px/1.7 var(--f-hud); letter-spacing: .06em; color: var(--dim); margin: 18px 0 0; }
#reading .seal span { display: block; }
#reading .seal .hash { letter-spacing: 0; overflow-wrap: anywhere; }
.epi { margin: 14px auto 0; max-width: 34rem; font: 400 13px/1.6 var(--f-type); font-stretch: 87.5%; color: var(--dim); }

.controls { position: absolute; z-index: 6; left: 0; right: 0; bottom: 0; display: flex; flex-wrap: wrap; gap: 8px; justify-content: center;
  padding: 12px 16px calc(14px + env(safe-area-inset-bottom, 0px)); background: linear-gradient(to top, rgba(3, 4, 6, .92), transparent); }
.controls[hidden] { display: none !important; }

#reading { max-width: 42rem; margin: 0 auto; padding-inline: 18px; padding-block: 130px 70px; }
#reading[hidden] { display: none; }
#reading h1 { margin: 0 0 10px; font: 900 clamp(32px, 7vw, 58px)/1 var(--f-title); letter-spacing: .04em;
  background: linear-gradient(180deg, var(--chrome-hi), var(--chrome-mid) 45%, var(--chrome-lo) 52%, #c9dcf5 60%, #5d82b6);
  -webkit-background-clip: text; background-clip: text; color: transparent; }
#reading h1:focus { outline: none; }                    /* focused only to move the reader there */
#reading .epi { margin: 18px 0 0; font: 400 16px/1.6 var(--f-type); font-stretch: 87.5%; color: var(--dim); }
#reading .kicker { font: 600 12px/1.6 var(--f-hud); letter-spacing: .2em; text-transform: uppercase; color: var(--dim); margin: 0 0 26px; }
#reading h2 { font: 700 18px/1.3 var(--f-title); letter-spacing: .1em; color: var(--white); margin: 38px 0 6px;
  display: flex; align-items: center; gap: 14px; }
#reading h2 .rav { flex: none; width: 64px; height: 64px; color: var(--chrome-mid); }   /* the agent's avatar, small and still */
#reading h2 .agentname, .readout .agentname { color: var(--chrome-mid); }
#reading p { font: 400 19px/1.62 var(--f-cap); margin: 0 0 14px; }
#reading .haiku { font: 400 17px/1.7 var(--f-type); font-stretch: 87.5%; color: var(--chrome-mid); margin: 18px 0 14px; padding-left: 16px; border-left: 2px solid var(--chrome-lo); }
#reading .stat { font: 400 12px/1.7 var(--f-hud); letter-spacing: .08em; color: var(--dim); text-transform: uppercase; }
#reading .coda { margin: 40px 0 0; padding-left: 16px; border-left: 2px solid var(--chrome-lo); }
#reading .coda cite { display: block; font: 400 12px/1.7 var(--f-hud); letter-spacing: .16em; text-transform: uppercase; color: var(--dim); font-style: normal; }
#reading .final { margin: 48px 0 0; font: 900 clamp(28px, 6vw, 46px)/1 var(--f-title); letter-spacing: .05em; text-transform: uppercase;
  background: linear-gradient(180deg, var(--chrome-hi), var(--chrome-mid) 45%, var(--chrome-lo) 52%, #c9dcf5 60%, #5d82b6);
  -webkit-background-clip: text; background-clip: text; color: transparent; }
#reading .final-sub { margin: 12px 0 0; font: 400 12px/1.7 var(--f-hud); letter-spacing: .22em; text-transform: uppercase; color: var(--dim); }
#reading .back { margin-top: 36px; display: flex; flex-wrap: wrap; gap: 10px; }

@media (max-width: 640px) {
  .pov-grid { grid-template-columns: minmax(0, 1fr); }
  /* the avatar, smaller, at the top right of the readout; the readout's lines run around it, so only a long line
     costs height */
  .readout, .reticle { grid-area: 1 / 1; }
  .reticle { width: 7rem; justify-self: end; align-self: start; }
  .readout::before { content: ""; float: right; width: 7rem; height: 7rem; margin: 0 0 4px 10px; }
  .tribute { grid-row: 2; }
  .hud.br, .hud.bl { display: none; }
  .scene { padding-top: 130px; }
}
/* short screens, a phone on its side: everything tighter, so the words stay clear of the quote and the controls */
@media (max-height: 520px) {
  .quote { padding-top: calc(8px + env(safe-area-inset-top, 0px)); padding-bottom: 8px; }
  .quote p { font-size: 11px; line-height: 1.45; }
  .quote cite { margin-top: 2px; font-size: 9px; letter-spacing: .16em; }
  .scene { padding: 64px 16px 60px; }
  .hud.br, .hud.bl { display: none; }
  .title { font-size: clamp(28px, 12vh, 60px); }
  .sub { margin-top: 12px; }
  .start-row { margin-top: 18px; }
  .note { margin-top: 10px; }
  #caption p { margin-bottom: 5vh; }
  #text p { font-size: 15px; line-height: 1.6; }
  /* the avatar, smaller, beside the readout's two columns */
  .pov-grid { grid-template-columns: minmax(0, 1fr) 6.5rem; gap: 10px 16px; }
  .readout, .reticle { grid-area: auto; }
  .readout::before { content: none; }
  .reticle { width: 6.5rem; align-self: start; }
  .tribute { grid-row: auto; }
  .readout { font-size: 11px; line-height: 1.5; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 24px; align-content: start; }
  .readout .h { grid-column: 1 / -1; }
  .tribute { min-height: 4.5em; }
  .tribute p { font-size: 14px; line-height: 1.5; }
  .tribute .haiku-label { font-size: 11px; margin-bottom: .3em; }
  #menu .box { font-size: 15px; line-height: 1.7; }
  #final h2 { font-size: clamp(30px, 14vh, 64px); }
  #reading { padding-top: 80px; }
}
/* a small phone on its side: a smaller avatar still, so the readout keeps its width */
@media (max-width: 640px) and (max-height: 520px) {
  .pov-grid { grid-template-columns: minmax(0, 1fr) 5rem; gap: 10px 12px; }
  .reticle { width: 5rem; }
}
/* short portrait phones (such as 375x553 with the browser's bars): tighter, so the tribute and haiku clear the controls */
@media (max-width: 640px) and (min-height: 521px) and (max-height: 660px) {
  .scene { padding-top: 84px; padding-bottom: 104px; }
  .readout { font-size: 11px; line-height: 1.5; }
  .tribute { min-height: 4.5em; }
  .tribute p { font-size: 14px; line-height: 1.5; }
}
@media (prefers-reduced-motion: reduce) { .ticker, .film::before, .film::after, .film i, .typed { animation: none; } .scene, .tribute p { transition: none; } }
</style>
</head>
<body>

{{QUOTE}}
<div id="theater">
  <svg width="0" height="0" style="position: absolute" aria-hidden="true" focusable="false">
    <filter id="rough" x="-4%" y="-15%" width="108%" height="130%">
      <feTurbulence id="roughnoise" type="fractalNoise" baseFrequency=".85" numOctaves="1" seed="3" result="n"/>
      <feDisplacementMap in="SourceGraphic" in2="n" scale="2.6" xChannelSelector="R" yChannelSelector="G"/>
    </filter>
  </svg>
  <div class="film" aria-hidden="true"><i></i></div>
  <div class="sr" id="sr" aria-live="polite"></div>
  <div class="hud bl" aria-hidden="true"><div class="ticker">{{TICKER}}</div></div>
  <div class="hud br" aria-hidden="true">{{HUD_BR}}</div>

  <section class="scene on" id="card"><div>
    <h1 class="title">{{TITLE_CARD}}</h1>
    <p class="sub">{{SUB}}</p>
    {{EPIGRAPH}}
    <div class="start-row">
      <button id="play" type="button">{{START}}</button>
      <button id="sound" type="button" aria-pressed="false">{{SOUND_OFF}}</button>
      {{MUSIC_BTN}}
      <button id="read" type="button">{{READ}}</button>
    </div>
    <p class="note">{{NOTE}}</p>
  </div></section>
  <section class="scene" id="caption" inert><p class="typed" id="captiontext" aria-hidden="true"></p></section>
  <section class="scene" id="text" inert><div><p class="typed" id="texttext" aria-hidden="true"></p><p class="typed by" id="textby" aria-hidden="true"></p></div></section>
  <section class="scene" id="pov" inert>
    <div class="pov-grid">
      <div class="readout" id="readout" aria-hidden="true"></div>
      <div class="reticle" id="reticle" aria-hidden="true"></div>
      <div class="tribute" id="tribute" aria-hidden="true"></div>
    </div>
  </section>
  <section class="scene" id="menu" inert><div class="box"><div class="h typed" id="menulabel"></div><ul id="menulist"></ul></div></section>
  <section class="scene" id="final" inert><div><h2 id="finaltext">{{FINAL}}</h2><p>{{FINAL_SUB}}</p>
    <div class="seal" aria-hidden="true"><p class="typed" id="seallabel"></p><p class="typed hash" id="sealhash"></p></div></div></section>

  <div class="controls" id="controls" hidden>
    <button id="pause" type="button" aria-pressed="false">{{PAUSE}}</button>
    <button id="sound2" type="button" aria-pressed="false">{{SOUND_OFF}}</button>
    {{MUSIC_BTN}}
    <button id="read2" type="button">{{READ}}</button>
    <button id="again" type="button" hidden>{{AGAIN}}</button>
  </div>
</div>

<article id="reading" hidden>
{{READING}}
  <div class="back"><button id="watch" type="button">{{WATCH}}</button>{{MUSIC_BTN}}</div>
</article>

<script>
(function () {
  const D = {{DATA}};
  const $ = (id) => document.getElementById(id);
  const theater = $("theater"), reading = $("reading"), controls = $("controls");
  const scenes = ["card", "caption", "text", "pov", "menu", "final"].map($);
  const reduce = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  let run = 0, paused = false, live = false;             // live: the film is running (to its last key), paused or not

  // sound: an original drone with metal, synthesized here
  let ac = null, master = null, timer = null, noise = null, step = 0, nextT = 0, soundOn = false;
  const STEP = 0.14, HITS = [1, 0, 0, 1, 0, 0, 1, 0, 0, 0, 1, 0];
  const CHORDS = [[110, 130.81, 164.81], [87.31, 110, 130.81], [73.42, 87.31, 110], [82.41, 103.83, 123.47]];
  function anvil(t, accent) {
    const o = ac.createOscillator(), g = ac.createGain();
    o.type = "sine"; o.frequency.setValueAtTime(150, t); o.frequency.exponentialRampToValueAtTime(46, t + 0.28);
    g.gain.setValueAtTime(accent ? 0.9 : 0.55, t); g.gain.exponentialRampToValueAtTime(0.001, t + 0.38);
    o.connect(g).connect(master); o.start(t); o.stop(t + 0.42);
    const n = ac.createBufferSource(), bp = ac.createBiquadFilter(), gn = ac.createGain();
    n.buffer = noise; bp.type = "bandpass"; bp.frequency.value = 2400; bp.Q.value = 7;
    gn.gain.setValueAtTime(accent ? 0.42 : 0.26, t); gn.gain.exponentialRampToValueAtTime(0.001, t + 0.16);
    n.connect(bp).connect(gn).connect(master); n.start(t); n.stop(t + 0.2);
    [517, 1163, 1739].forEach((f, i) => { const r = ac.createOscillator(), gr = ac.createGain(); r.type = "triangle"; r.frequency.value = f;
      gr.gain.setValueAtTime((accent ? 0.07 : 0.045) / (i + 1), t); gr.gain.exponentialRampToValueAtTime(0.0004, t + 0.7);
      r.connect(gr).connect(master); r.start(t); r.stop(t + 0.75); });
  }
  function chord(t, idx) {
    CHORDS[idx % CHORDS.length].forEach((f) => { const o = ac.createOscillator(), g = ac.createGain(); o.type = "triangle"; o.frequency.value = f;
      g.gain.setValueAtTime(0.0001, t); g.gain.linearRampToValueAtTime(0.03, t + 2.5); g.gain.linearRampToValueAtTime(0.0001, t + 13.2);
      o.connect(g).connect(master); o.start(t); o.stop(t + 13.5); });
  }
  function drone() {
    const lp = ac.createBiquadFilter(), g = ac.createGain(), lfo = ac.createOscillator(), lg = ac.createGain();
    lp.type = "lowpass"; lp.frequency.value = 360; g.gain.value = 0.11; lfo.frequency.value = 0.05; lg.gain.value = 140;
    lfo.connect(lg).connect(lp.frequency); lfo.start();
    [55, 55.35, 27.5].forEach((f) => { const o = ac.createOscillator(); o.type = "sawtooth"; o.frequency.value = f; o.connect(lp); o.start(); });
    lp.connect(g).connect(master);
  }
  function schedule() { while (nextT < ac.currentTime + 0.25) { if (HITS[step % 12]) anvil(nextT, step % 12 === 0); if (step % 96 === 0) chord(nextT, step / 96); nextT += STEP; step++; } }
  function soundStart() {
    try {
      if (!ac) { ac = new (window.AudioContext || window.webkitAudioContext)(); master = ac.createGain(); master.gain.value = 0; master.connect(ac.destination);
        noise = ac.createBuffer(1, ac.sampleRate * 0.3, ac.sampleRate); const d = noise.getChannelData(0); for (let i = 0; i < d.length; i++) d[i] = Math.random() * 2 - 1; drone(); }
      if (paused) ac.suspend(); else ac.resume();          // turned on during a pause, it waits for the film
      master.gain.cancelScheduledValues(ac.currentTime); master.gain.setTargetAtTime(0.75, ac.currentTime, 1.2);
      nextT = ac.currentTime + 0.1; clearInterval(timer); timer = setInterval(schedule, 50); soundOn = true;
    } catch (e) { soundOn = false; }
    syncSound();
  }
  function soundStop() { soundOn = false; try { clearInterval(timer); if (ac) { master.gain.setTargetAtTime(0, ac.currentTime, 0.4); setTimeout(() => { if (!soundOn && ac) ac.suspend(); }, 3000); } } catch (e) {} syncSound(); }
  function syncSound() { ["sound", "sound2"].forEach((id) => { const b = $(id); b.setAttribute("aria-pressed", String(soundOn)); b.textContent = soundOn ? D.labels.on : D.labels.off; }); }
  $("sound").onclick = $("sound2").onclick = () => (soundOn ? soundStop() : soundStart());

  // the keys: a type bar on the platen, softer for a space, heavy for the last line; a tick for the machine's readout
